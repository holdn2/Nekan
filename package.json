{
  "name": "nekan",
  "version": "1.0.0",
  "description": "Nekan — Eisenhower matrix desktop widget",
  "main": "out/main.js",
  "imports": {
    "#shared/*": "./out/shared/*",
    "#main/*": "./out/main/*"
  },
  "author": "makersfarm",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.js",
    "build:watch": "node tools/build.js --watch",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.renderer.strict.json && tsc -p tsconfig.shared.json",
    "test": "npm run build && node --test \"out/test/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "npm run build && electron-builder --win nsis --publish always && node tools/check-release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.makersfarm.nekan",
    "productName": "Nekan",
    "files": [
      "out/**/*",
      "package.json",
      "!out/**/*.d.ts",
      "!out/.tsbuildinfo-*",
      "!out/test/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Nekan",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "holdn2",
        "repo": "Nekan"
      }
    ]
  }
}
