{
  "name": "nekan",
  "version": "1.0.2",
  "description": "Nekan — Eisenhower matrix desktop widget",
  "main": "out/main.js",
  "imports": {
    "#shared/*": "./out/shared/*",
    "#main/*": "./out/main/*",
    "#tools/*": "./tools/*"
  },
  "workspaces": [
    "src/shared",
    "apps/mobile"
  ],
  "overrides": {
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1"
  },
  "author": "makersfarm",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.js",
    "build:watch": "node tools/build.js --watch",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.shared.json",
    "test": "npm run build && node tools/check-styles.js && node tools/check-colors.js && node --test \"out/test/**/*.test.js\" && vitest run",
    "check:styles": "node tools/check-styles.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && electron .",
    "mobile": "npm run --workspace @nekan/mobile start --",
    "mobile:typecheck": "tsc -p apps/mobile --noEmit",
    "dist": "npm run build && node tools/dist.js",
    "dist:mac": "npm run build && node tools/dist.js --mac",
    "release": "npm run build && node tools/dist.js --publish"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.makersfarm.nekan",
    "productName": "Nekan",
    "files": [
      "out/**/*",
      "package.json",
      "!out/**/*.d.ts",
      "!out/.tsbuildinfo-*",
      "!out/test/**",
      "!out/renderer/**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Nekan",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "holdn2",
        "repo": "Nekan"
      }
    ]
  }
}
