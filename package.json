{
  "name": "nekan",
  "version": "1.0.0",
  "description": "Nekan — Eisenhower matrix desktop widget",
  "main": "src/main.js",
  "author": "makersfarm",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.makersfarm.nekan",
    "productName": "Nekan",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}
