{
  "sourceLanguage": "en",
  "strings": {
    "widget.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a task straight from the lock screen or the home screen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금화면이나 홈 화면에서 바로 할 일을 적습니다"
          }
        }
      }
    },
    "widget.speak": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak a task"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말로 적기"
          }
        }
      }
    },
    "widget.write": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a task"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 적기"
          }
        }
      }
    },
    "widget.boardDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See one quadrant's tasks, and switch board or quadrant right on the widget."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 분면의 할 일을 봅니다. 업무·일상과 분면을 위젯에서 바로 바꿉니다"
          }
        }
      }
    },
    "widget.openApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Nekan once and your tasks will show up here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekan을 한 번 열면 할 일이 여기 나타납니다"
          }
        }
      }
    }
  },
  "version": "1.0"
}
