{
  "expo": {
    "name": "Nekan",
    "slug": "nekan",
    "scheme": "nekan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.makersfarm.nekan",
      "supportsTablet": false
    },
    "android": {
      "package": "com.makersfarm.nekan"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
