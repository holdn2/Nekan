{
  // The unit tests. CommonJS like the main process, because that is what
  // `node --test` loads them as, and they require the same built modules main
  // does -- out/shared/ is ES modules and require() reaches it the same way.
  //
  // A project of its own so it lands in out/test/, away from the app it
  // tests: `files` in package.json drops out/test/** from the package, and
  // out/shared/ is ES modules while these are not.
  //
  // The sources sit beside what they cover -- src/shared/test/, src/main/test/,
  // tools/test/ -- so a rule and its test are in the same place. That works
  // only because they import through #shared/*, #main/* and #tools/*, which
  // name the module from the package root: a relative path would follow the
  // file here and point at nothing once the output moves to out/test/.
  //
  // rootDir is the repository rather than src/ because one of the things under
  // test is not in src/ at all: tools/check-release.js runs after the build,
  // not as part of it, so its test sits beside it. A project has one rootDir,
  // and the only directory holding both src/ and tools/ is the repository. So
  // out/test/ mirrors the repository -- out/test/src/... and out/test/tools/...
  // -- and tools/build.js has to look for their sources from here, not from
  // src/.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The same two names the repository's package.json already maps, spelled
    // again for the compiler. `#shared/*` is resolved from the *nearest*
    // package.json, and src/shared/ has one of its own since it became a
    // workspace -- so the tests under it stopped seeing the root mapping and
    // every #shared/ and #main/ import failed to type-check. Node is not
    // affected: it resolves these at runtime from out/test/, where the nearest
    // package.json is still the repository's. Two mechanisms, one target; the
    // compiler needs this line because the package boundary now sits between
    // the test and the map. A target that climbs out of src/shared/ was tried
    // first and rejected -- an imports target may not leave its package.
    "paths": { "#shared/*": ["./out/shared/*"], "#main/*": ["./out/main/*"] },
    // The one place that is not strict, and on purpose. Its 79 complaints are
    // almost all "possibly null" about a value the test itself just built and
    // is about to assert on -- a null there fails the test, loudly, which is
    // the whole job of the file. Tightening it would buy a safety net for the
    // safety net.
    "strict": false,
    "rootDir": ".",
    "outDir": "out/test",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["src/**/test/**/*.ts", "tools/**/test/**/*.ts"],
  "references": [
    { "path": "./tsconfig.shared.json" },
    { "path": "./tsconfig.main.json" }
  ]
}
