<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime, which notarisation requires.

  Nothing here is a capability this app asked for: all three are what V8 needs
  to run at all once the hardened runtime is on. Without them the packaged app
  launches to a blank window and the crash is inside Electron, not our code.

  Deliberately not here: com.apple.security.app-sandbox and the network/file
  entitlements that go with it. Those belong to the Mac App Store target, which
  this app does not build. It ships through GitHub Releases, and sandboxing
  would take away the loopback listener that Google sign-in returns to.

  No double hyphen anywhere in this comment, and none in the ones below. This
  repository writes them for an em dash, which is fine in JavaScript and illegal
  inside an XML comment. codesign reads this file with AMFI's own parser, which
  says so plainly and then takes the whole build down with it:

    Failed to parse entitlements: AMFIUnserializeXML: syntax error near line 10

  That was line 10 of this file, and it cost the first signed build (2026-08-24).
  tools/test/entitlements.test.ts is there so it costs the next one nothing.
-->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Some of V8's memory is written and then executed, which the hardened
         runtime otherwise refuses outright. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Electron reads DYLD_* to find the frameworks inside the .app bundle. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
