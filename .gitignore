node_modules/
dist/
*.log

# 서버 접속 정보. anon key는 공개돼도 되지만(RLS가 방어선), 파일로 두면
# service_role 키가 섞여 들어가는 순간 돌이킬 수 없다.
.env
.env.*

# 세션 산출물(보고서·분석 문서)은 로컬에만 둔다
docs/discussions/

# TypeScript build output. `out/` is the app that actually runs;
# `src/` is what is written.
out/

# Compiler bookkeeping.
*.tsbuildinfo

# 손으로 만져 보는 QA 프로필 (세션용, 저장소에 올리지 않는다)
.qa/
dist*/

# Expo writes these into the app it is serving: a dev-server handle and the
# route types it regenerates from the app/ directory. Both follow the machine,
# not the repository.
apps/*/.expo/

# The Supabase CLI writes this when it talks to the project. Machine state,
# not the repo: it names the linked project and caches a version check.
supabase/.temp/

# Written by @bacons/apple-targets at prebuild from expo-target.config.js
# (`images`). Generated, like ios/ itself.
apps/mobile/targets/*/Assets.xcassets/
apps/mobile/targets/*/gen-image/
